{
  "name": "pov559-gallery",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/prep_data.ts && bun scripts/bundle.ts",
    "build:check": "bun scripts/prep_data.ts && bun scripts/bundle.ts --check",
    "seed": "bun scripts/make-kv-bulk.ts",
    "dev": "bunx wrangler dev",
    "deploy": "bun scripts/setup-kv.cjs --no-seed && bun run build && bunx wrangler deploy",
    "deploy:seed": "bun scripts/setup-kv.cjs && bunx wrangler deploy",
    "kv:force-seed": "bun scripts/setup-kv.cjs --force-seed",
    "setup-kv": "bun scripts/setup-kv.cjs --no-seed",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2"
  }
}
