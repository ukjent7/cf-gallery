{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": false,
    "types": ["bun"]
  },
  "include": [
    "src/gallery/js/**/*.js",
    "src/gallery/js/**/*.d.ts",
    "scripts/**/*.ts"
  ]
}
